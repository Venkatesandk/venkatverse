    `mentor_id` INT UNSIGNED NOT NULL DEFAULT 0,
    `company` VARCHAR(255) DEFAULT NULL,
    `batch_id` INT UNSIGNED NOT NULL DEFAULT 0,
    `degree_type_id` INT UNSIGNED NOT NULL DEFAULT 0,
    `degree_branch_id` INT UNSIGNED NOT NULL DEFAULT 0,
    `section_id` INT UNSIGNED NOT NULL DEFAULT 0,
    `end_date` DATE DEFAULT NULL,
    `current_stage` VARCHAR(100) NOT NULL DEFAULT 'Student Updates',
    `registration_open` TINYINT(1) NOT NULL DEFAULT 0,
    `academic_term_id` INT UNSIGNED NOT NULL DEFAULT 0,
    `created_by` INT UNSIGNED NOT NULL DEFAULT 0,
    `is_deleted` TINYINT(1) NOT NULL DEFAULT 0,
    `created_date` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    `updated_date` DATETIME DEFAULT NULL,
    PRIMARY KEY (`group_id`),
    KEY `idx_ii_groups_created_by` (`created_by`),
    KEY `idx_ii_groups_academic_term` (`academic_term_id`),
    KEY `idx_ii_groups_stage` (`current_stage`),
    KEY `idx_ii_groups_deleted` (`is_deleted`),
    KEY `idx_ii_groups_mentor` (`mentor_id`),
    KEY `idx_ii_groups_term_deleted` (`academic_term_id`, `is_deleted`),
    KEY `idx_ii_groups_mentor_deleted` (`mentor_id`, `is_deleted`),
    KEY `idx_ii_groups_created_deleted` (`created_by`, `is_deleted`),
    KEY `idx_ii_groups_stage_deleted` (`current_stage`, `is_deleted`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

